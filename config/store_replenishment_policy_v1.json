  },
  "review": {
    "review_mode": "CONTINUOUS_DAILY",
    "recalibration_days": 7,
    "demand_lookback_days": 84,
    "dc_to_store_lead_time_days": 1
  },
  "mature_replenishment": {
    "method": "EMPIRICAL_ROLLING_DEMAND_QUANTILES",
    "abc_service_quantiles": {
      "A": 0.99,
      "B": 0.98,
      "C": 0.95
    },
    "reorder_point": {
      "demand_window_days": 2,
      "formula": "ceil(empirical ABC quantile of rolling 2-day demand over trailing 84 days)",
      "minimum_units": 1
    },
    "target_stock": {
      "demand_window_days": 4,
      "formula": "ceil(empirical ABC quantile of rolling 4-day demand over trailing 84 days)",
      "minimum_units": 1,
      "constraint": "TargetStockQty >= ReorderPointQty"
    },
    "request_formula": "max(0, TargetStockQty - (OnHandQty + InTransitQty)) when InventoryPosition <= ReorderPointQty"
  },
  "dormancy": {
    "days_without_positive_demand": 168,
    "decision": "REVIEW",
    "automatic_discontinue": false,
    "service_buffer_units": 1,
    "reactivation": "Re-enter rolling mature policy after positive demand becomes historically available"
  },
  "new_assortment": {
    "launch_calibration_window_days": 7,
    "calibration_burn_in_days": 28,
    "known_product_new_store_quantile": 0.95,
    "new_to_network_quantile": 0.99,
    "hierarchy": [
      "PRODUCT_HISTORY_OTHER_STORES",
      "PRODUCT_SUBCATEGORY_X_ABC",
      "ABC_CLASS"
    ],
    "minimum_product_launch_events": 3,
    "minimum_subcategory_abc_launch_events": 20,
    "minimum_initial_allocation_units": 1,
    "launch_quantity_future_leakage": false
  },
  "physical_flow": {
    "store_inventory_cannot_be_negative": true,
    "dc_inventory_cannot_be_negative": true,
    "dc_ships_at_most_available_inventory": true,
    "partial_dc_fulfillment_allowed": true,
    "unfilled_store_request": "TRACK_AS_DC_CAPACITY_SHORTAGE; do not fabricate shipment",
    "only_actual_grn_increases_dc_on_hand": true,
    "supplier_backorder_and_residual_cancellation": "Use frozen SUPPLIER_DC_EXECUTION_V1 mechanics"
  },
  "validation_contract": {
