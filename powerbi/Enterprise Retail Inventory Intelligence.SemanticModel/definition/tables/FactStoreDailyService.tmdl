	partition FactStoreDailyService = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "/analytics_v1/analytics_store_daily_service_v1.csv"), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    BlanksAsNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(BlanksAsNull, {{"Date", type date}, {"Store", type text}, {"DemandQty", Int64.Type}, {"FulfilledQty", Int64.Type}, {"ShortageQty", Int64.Type}, {"ReturnInflowQty", Int64.Type}, {"UnitServiceRate", type number}, {"DevelopmentPhase", type text}, {"DemandProvenance", type text}, {"ReturnProvenance", type text}}, "en-US")
				in
